[run]
source = tigeropen
omit =
    # demo 脚本，不属于 SDK 对外行为
    tigeropen/examples/*
    # protoc 生成，不手写不测
    tigeropen/push/pb/*_pb2.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
show_missing = True
skip_covered = False
